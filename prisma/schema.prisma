// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model VillaOwner {
  id           String        @id @default(cuid())
  name         String
  email        String?
  unitNumber   String?
  passwordHash String?
  monthlyDues  Float         @default(0)
  transactions Transaction[]
  visitorLogs  VisitorLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id          String      @id @default(cuid())
  type        String      // "INCOME" or "EXPENSE"
  amount      Float
  date        DateTime
  description String
  category    String?     // e.g. "Wages", "Village Expenses", etc.
  ownerId     String?
  owner       VillaOwner? @relation(fields: [ownerId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model FileEntry {
  id        String   @id @default(cuid())
  title     String
  type      String   // "DOCUMENT", "PHOTO", "VIDEO"
  url       String   // local path like "/uploads/xyz.pdf"
  sizeBytes Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SecurityGuard {
  id            String             @id @default(cuid())
  fingerprintId Int                @unique // Matches R307 sensor slot (1-127)
  name          String
  role          String             // "Security 1", "Security 2", etc.
  shift         String             // "Day" or "Night"
  shiftStart    String             // "06:00" or "18:00"
  isActive      Boolean            @default(true)
  records       AttendanceRecord[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model AttendanceRecord {
  id          String        @id @default(cuid())
  guardId     String
  guard       SecurityGuard @relation(fields: [guardId], references: [id])
  date        String        // "YYYY-MM-DD" for easy querying
  checkIn     DateTime
  checkOut    DateTime?
  hoursWorked Float?        // Calculated on check-out
  status      String        // "present" or "late"
  autoClosedBy String?      // Guard ID who triggered auto-close, null if manual
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model VisitorLog {
  id        String      @id @default(cuid())
  ownerId   String?
  owner     VillaOwner? @relation(fields: [ownerId], references: [id])
  page      String
  ipAddress String?
  userAgent String?
  visitedAt DateTime    @default(now())
}

model MonthlyBalance {
  id     String @id @default(cuid())
  year   Int
  month  Int    // 1-12
  amount Float
  @@unique([year, month])
}
